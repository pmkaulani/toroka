# Copy to .env and fill in. Keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  and  openssl rand -hex 32
SSI_ENV=production
DATABASE_URL=postgresql+psycopg://ssi:change-me@db:5432/ssi
ENCRYPTION_KEY=
HMAC_KEY=
DIAGNOSTICS_API_KEY=          # Optional dedicated key for trusted diagnostics monitors; never reuse HMAC_KEY
PUBLIC_BASE_URL=https://your-domain.example
STORAGE_DIR=/data/evidence
RETENTION_DAYS=7
TRUST_PROXY_HEADERS=1            # only behind a proxy that sets X-Forwarded-For

# Link checks (all optional; unset means "not checked" is shown to users)
WEBRISK_API_KEY=                 # Google Web Risk: licensed for commercial use. Safe Browsing is non-commercial only.
TAVILY_API_KEY=                  # Optional public-web search for domains/social handles; results are leads, not proof.
WEIR_API_KEY=                    # Optional X/Reddit public-post search; server-side only.
SCRAPE_CREATORS_API_KEY=         # Optional public Instagram/TikTok/Facebook profile inspection; server-side only.
INTELLIGENCE_CACHE_TTL_SECONDS=900 # In-process public-evidence cache TTL; 0 disables caching.
GOOGLE_PLACES_API_KEY=             # Optional Google Places API (New); public shop-location candidate search.
URLSCAN_API_KEY=                    # Optional urlscan.io historical domain search; does not submit or scan user URLs.
PHISHTANK_APP_KEY=                  # Optional PhishTank registered app key for verified phishing checks.
VIRUSTOTAL_API_KEY=                 # Optional VirusTotal key; requires commercial & downstream-display license.
TOROKA_VIRUSTOTAL_DISPLAY_LICENSE_CONFIRMED=0 # Must be 1 to enable VirusTotal provider.
TOROKA_ENTITY_HASH_SECRET=          # Secret (>= 32 chars) for HMAC hashing of seller identifiers in evidence memory.
BLOCKLIST_PATH=                  # JSON {"entries":[{"value":"bad.example","kind":"domain","threat":"SOCIAL_ENGINEERING"}]}
ENABLE_LINK_FETCH=1              # 1 = safely inspect plain websites; SSRF protections are mandatory. Set 0 to disable outbound page reads.
ENABLE_RDAP=0
GEOCODER_USER_AGENT=             # e.g. "SSI/0.1 (contact@your-domain.example)"; enables the OpenStreetMap place check

# Channels (optional; need approved accounts)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AT_USERNAME=
AT_API_KEY=
AT_SHORTCODE=
AT_CALLBACK_SECRET=              # long random string used in the callback path

DEV_ECHO_CODES=0                 # never 1 in production: it returns appeal verification codes in the response

# AI Frontier Engine (Optional: without keys, Toroka runs offline Kenyan expert intelligence)
GEMINI_API_KEY=                     # Get free key at https://aistudio.google.com/app/apikey (enables Gemini 2.5 Flash multimodal)
OPENAI_API_KEY=                     # OpenAI API Key (enables GPT-4o / GPT-4o-mini)
ANTHROPIC_API_KEY=                  # Anthropic Claude API Key
AI_MODEL=gemini-2.5-flash           # Default AI model for multi-turn conversational reasoning
AI_TIMEOUT_SECONDS=12              # 3-30 seconds; affects optional AI rewording only

# Rate limits (requests/seconds). Defaults are conservative for guests.
# RL_CHECKS=20/3600  RL_EVIDENCE=15/3600  RL_REPORTS=10/86400  RL_SEARCH=30/3600  RL_AUTH=10/900  RL_APPEALS=5/86400  RL_SEARCH_DISTINCT=10

# -----------------------------------------------------------------------------
# Toroka Enterprise API Configuration (Bank Pilot Operations Layer)
# -----------------------------------------------------------------------------
# Environment: 'development' or 'production' (development allows local loopback dev auth)
TOROKA_ENT_ENV=development

# Required when TOROKA_ENT_ENV is 'staging' or 'production': HMAC key (>= 32 bytes) that signs audit checkpoints.
# The checkpoint directory itself is set in compose; point it at write-once / off-host storage in real deployments.
TOROKA_ENT_AUDIT_CHECKPOINT_KEY=change-me-use-at-least-32-random-bytes

# Authentication mode: 'oidc' (production mandatory) or 'development' (local loopback only)
TOROKA_ENT_AUTH_MODE=development

# OIDC Identity Provider Configuration (Required when TOROKA_ENT_AUTH_MODE=oidc)
TOROKA_ENT_OIDC_ISSUER=https://idp.bank.example.com
TOROKA_ENT_OIDC_AUDIENCE=toroka-enterprise-api
TOROKA_ENT_OIDC_JWKS_URL=https://idp.bank.example.com/.well-known/jwks.json

# JWT Claim name containing user group memberships or roles (default: 'groups')
TOROKA_ENT_ROLE_CLAIM=groups

# Supported JWT signing algorithms (comma-separated, e.g. 'RS256', 'RS256,ES256')
TOROKA_ENT_OIDC_ALGORITHMS=RS256

# Bank Identity Provider Group-to-Toroka Role Mapping (JSON Object)
# Valid Toroka internal roles: 'investigator', 'authoriser', 'auditor', 'data_steward', 'system_administrator'
TOROKA_ENT_ROLE_MAP_JSON={"BANK_FRAUD_INVESTIGATORS": "investigator", "BANK_RISK_AUTH": "authoriser", "BANK_INTERNAL_AUDIT": "auditor", "BANK_OPS_STEWARD": "data_steward", "BANK_SYS_ADMINS": "system_administrator"}

# Operational Database URL (PostgreSQL required in production, SQLite permitted in dev/test)
TOROKA_ENT_DATABASE_URL=sqlite:///./enterprise_operational.db
# Production example: postgresql+psycopg://toroka_ent:secure-db-pass@db-cluster.bank.local:5432/toroka_enterprise

# Identity Vault Database URL (Must be isolated from operational database in production)
TOROKA_ENT_VAULT_DATABASE_URL=sqlite:///./enterprise_vault.db
# Production example: postgresql+psycopg://toroka_vault:vault-secret-pass@vault-db.bank.local:5432/toroka_vault

# Identity Vault Encryption Key (Base64-encoded 32-byte Fernet key; mandatory in production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOROKA_ENT_VAULT_KEY=
TOROKA_ENT_VAULT_KEY_VERSION=v1

# Enterprise Deployment Installation Identifier
TOROKA_ENT_INSTALLATION_ID=toroka-default-installation


